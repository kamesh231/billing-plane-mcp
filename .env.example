# Lovable Subscription Foundation - Environment Variables

# ============================================
# Supabase Configuration
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api

# Public variables (safe to expose in frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# Stripe Configuration
# ============================================
# Get these from: https://dashboard.stripe.com/apikeys

# Public key (safe to expose in frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret keys (NEVER expose in frontend - use in Edge Functions only)
# Set these in Supabase: supabase secrets set STRIPE_SECRET_KEY=sk_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# License Configuration (Optional)
# ============================================
# Pro License: Get from your purchase email
# Format: LSF-{encrypted_key} (200+ characters)
# Setting a valid license key removes the "Powered by" badge
# NEXT_PUBLIC_LOVABLE_SUBSCRIPTION_LICENSE_KEY=LSF-your_license_key_here

# ============================================
# Application Configuration (Optional)
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Your App Name

# ============================================
# Instructions
# ============================================
#
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Fill in your Supabase credentials:
#    - Go to https://app.supabase.com
#    - Select your project
#    - Go to Settings > API
#    - Copy Project URL and anon/public key
#
# 3. Fill in your Stripe credentials:
#    - Go to https://dashboard.stripe.com
#    - Get your publishable key (pk_test_...)
#    - Get your secret key (sk_test_...) - DO NOT commit this!
#    - Set up webhook and get signing secret (whsec_...)
#
# 4. Set Supabase secrets (for Edge Functions):
#    supabase secrets set STRIPE_SECRET_KEY=sk_test_...
#    supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
#    supabase secrets set SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
#
# 5. Never commit .env.local to git!
#    (It's already in .gitignore)
